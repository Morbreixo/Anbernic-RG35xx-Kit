+/**
+ * Personal splash ("Allahu Corp") shown before the game starts.
+ * Looks for splash.png in the working folder or the data folder.
+ * Fades in/out through the 8-bit palette; any key or button skips it.
+ */
+static void showSplash()
+{
+	SDL_Surface *img = IMG_Load("splash.png");
+	if (!img) img = IMG_Load((Options::getDataFolder() + "splash.png").c_str());
+	if (!img) return;
+	SDL_Surface *disp = SDL_GetVideoSurface();
+	if (!disp) { SDL_FreeSurface(img); return; }
+	bool paletted = disp->format->BitsPerPixel == 8 && img->format->palette;
+	SDL_Color base[256];
+	memset(base, 0, sizeof(base));
+	if (paletted)
+	{
+		for (int i = 0; i < img->format->palette->ncolors && i < 256; ++i) base[i] = img->format->palette->colors[i];
+		SDL_Color black[256];
+		memset(black, 0, sizeof(black));
+		SDL_SetPalette(disp, SDL_LOGPAL | SDL_PHYSPAL, black, 0, 256);
+	}
+	SDL_FillRect(disp, 0, 0);
+	SDL_Rect dst;
+	dst.x = (Sint16)((disp->w - img->w) / 2);
+	dst.y = (Sint16)((disp->h - img->h) / 2);
+	if (paletted)
+	{
+		// same palette on both sides: copy raw indices
+		SDL_SetPalette(img, SDL_LOGPAL, base, 0, 256);
+		SDL_LockSurface(disp);
+		for (int y = 0; y < img->h; ++y)
+		{
+			int dy = dst.y + y;
+			if (dy < 0 || dy >= disp->h) continue;
+			Uint8 *srow = (Uint8*)img->pixels + y * img->pitch;
+			Uint8 *drow = (Uint8*)disp->pixels + dy * disp->pitch;
+			for (int x = 0; x < img->w; ++x)
+			{
+				int dx = dst.x + x;
+				if (dx >= 0 && dx < disp->w) drow[dx] = srow[x];
+			}
+		}
+		SDL_UnlockSurface(disp);
+	}
+	else
+	{
+		SDL_BlitSurface(img, 0, disp, &dst);
+	}
+	const Uint32 fadeIn = 500, total = 3200, fadeOut = 500;
+	Uint32 start = SDL_GetTicks();
+	bool skip = false;
+	while (true)
+	{
+		Uint32 t = SDL_GetTicks() - start;
+		SDL_Event ev;
+		while (SDL_PollEvent(&ev))
+		{
+			if (ev.type == SDL_KEYDOWN || ev.type == SDL_MOUSEBUTTONDOWN || ev.type == SDL_JOYBUTTONDOWN || ev.type == SDL_QUIT)
+			{
+				if (!skip && t < total - fadeOut) { skip = true; start = SDL_GetTicks() - (total - fadeOut); t = total - fadeOut; }
+			}
+		}
+		if (t >= total) break;
+		if (paletted)
+		{
+			double k = 1.0;
+			if (t < fadeIn) k = (double)t / fadeIn;
+			else if (t > total - fadeOut) k = (double)(total - t) / fadeOut;
+			SDL_Color cur[256];
+			for (int i = 0; i < 256; ++i)
+			{
+				cur[i].r = (Uint8)(base[i].r * k);
+				cur[i].g = (Uint8)(base[i].g * k);
+				cur[i].b = (Uint8)(base[i].b * k);
+				cur[i].unused = 0;
+			}
+			SDL_SetPalette(disp, SDL_LOGPAL | SDL_PHYSPAL, cur, 0, 256);
+		}
+		SDL_Flip(disp);
+		SDL_Delay(15);
+	}
+	SDL_FillRect(disp, 0, 0);
+	SDL_Flip(disp);
+	SDL_FreeSurface(img);
+	// drop any input that arrived during the splash
+	SDL_Event ev;
+	while (SDL_PollEvent(&ev)) {}
+}

+// ---------------------------------------------------------------------------
+// On-screen keyboard (handhelds). Opens by itself when a text field gets the
+// focus, or with L1+R1. D-pad picks a key, A types it, B deletes, X = Enter,
+// Start closes it. Drawn see-through (dithered) over the game.
+// ---------------------------------------------------------------------------
+namespace OSK
+{
+	enum Special { K_CHAR = 0, K_SHIFT, K_SPACE, K_LEFT, K_RIGHT, K_DEL, K_OK };
+	struct Key { std::string low, up; UCode cLow, cUp; Special sp; int units; int x, y, w, h; Text *txt; std::string shown; };
+
+	static bool visible = false, autoOpened = false, wasFocused = false, shift = true, built = false;
+	static std::vector<std::vector<Key> > rows;
+	static int selRow = 1, selCol = 0;
+	static int heldDir = -1;
+	static Uint32 heldSince = 0, lastRep = 0;
+	static int originX = 0, originY = 0, totalW = 0, totalH = 0;
+	static bool atTop = false;
+	static Game *game = 0;
+	static const int KH = 13, UNIT = 26, PAD = 3;
+
+	static Key mk(const std::string &l, const std::string &u, UCode cl, UCode cu, Special sp = K_CHAR, int units = 1)
+	{
+		Key k; k.low = l; k.up = u; k.cLow = cl; k.cUp = cu; k.sp = sp; k.units = units; k.x = k.y = k.w = k.h = 0; k.txt = 0;
+		return k;
+	}
+
+	static void addChars(std::vector<Key> &row, const char *lo, const char *hi)
+	{
+		for (size_t i = 0; lo[i]; ++i)
+		{
+			row.push_back(mk(std::string(1, lo[i]), std::string(1, hi[i]), (UCode)(unsigned char)lo[i], (UCode)(unsigned char)hi[i]));
+		}
+	}
+
+	static void build()
+	{
+		if (built) return;
+		built = true;
+		rows.resize(5);
+		addChars(rows[0], "1234567890-", "!?#$%&/()=_");
+		addChars(rows[1], "qwertyuiop", "QWERTYUIOP");
+		addChars(rows[2], "asdfghjkl", "ASDFGHJKL");
+		rows[2].push_back(mk("\xC3\xB1", "\xC3\x91", 0xF1, 0xD1));
+		addChars(rows[3], "zxcvbnm,.'", "ZXCVBNM;:\"");
+		rows[4].push_back(mk("Mayus", "Mayus", 0, 0, K_SHIFT, 2));
+		rows[4].push_back(mk("Espacio", "Espacio", ' ', ' ', K_SPACE, 4));
+		rows[4].push_back(mk("<", "<", 0, 0, K_LEFT, 1));
+		rows[4].push_back(mk(">", ">", 0, 0, K_RIGHT, 1));
+		rows[4].push_back(mk("Borrar", "Borrar", 0, 0, K_DEL, 2));
+		rows[4].push_back(mk("OK", "OK", 0, 0, K_OK, 2));
+	}
+
+	static void layout()
+	{
+		int maxUnits = 0;
+		for (size_t r = 0; r < rows.size(); ++r)
+		{
+			int u = 0;
+			for (size_t c = 0; c < rows[r].size(); ++c) u += rows[r][c].units;
+			maxUnits = std::max(maxUnits, u);
+		}
+		totalW = maxUnits * UNIT + PAD * 2;
+		totalH = (int)rows.size() * (KH + 1) + PAD * 2 - 1;
+		originX = (Options::baseXResolution - totalW) / 2;
+		originY = atTop ? 2 : Options::baseYResolution - totalH - 2;
+		for (size_t r = 0; r < rows.size(); ++r)
+		{
+			int u = 0;
+			for (size_t c = 0; c < rows[r].size(); ++c) u += rows[r][c].units;
+			int x = originX + PAD + (maxUnits - u) * UNIT / 2;
+			for (size_t c = 0; c < rows[r].size(); ++c)
+			{
+				Key &k = rows[r][c];
+				k.x = x; k.y = originY + PAD + (int)r * (KH + 1);
+				k.w = k.units * UNIT - 1; k.h = KH;
+				x += k.units * UNIT;
+				if (k.txt) { k.txt->setX(k.x); k.txt->setY(k.y + 3); }
+			}
+		}
+	}
+
+	static void open(bool automatic, bool top)
+	{
+		build();
+		visible = true;
+		autoOpened = automatic;
+		atTop = top;
+		shift = true;
+		layout();
+	}
+
+	static void close()
+	{
+		visible = false;
+		autoOpened = false;
+		heldDir = -1;
+	}
+
+	static void toggle()
+	{
+		if (visible) close(); else open(false, false);
+	}
+
+	static void pushKey(SDLKey sym, UCode uc)
+	{
+		SDL_Event ev;
+		memset(&ev, 0, sizeof(ev));
+		ev.type = SDL_KEYDOWN;
+		ev.key.type = SDL_KEYDOWN;
+		ev.key.state = SDL_PRESSED;
+		ev.key.keysym.sym = sym;
+		ev.key.keysym.unicode = (Uint16)uc;
+		SDL_PushEvent(&ev);
+		ev.type = SDL_KEYUP;
+		ev.key.type = SDL_KEYUP;
+		ev.key.state = SDL_RELEASED;
+		SDL_PushEvent(&ev);
+	}
+
+	static void press()
+	{
+		Key &k = rows[selRow][selCol];
+		switch (k.sp)
+		{
+		case K_SHIFT: shift = !shift; break;
+		case K_SPACE: pushKey(SDLK_SPACE, ' '); break;
+		case K_LEFT: pushKey(SDLK_LEFT, 0); break;
+		case K_RIGHT: pushKey(SDLK_RIGHT, 0); break;
+		case K_DEL: pushKey(SDLK_BACKSPACE, 8); break;
+		case K_OK: pushKey(SDLK_RETURN, 13); break;
+		default:
+		{
+			UCode c = shift ? k.cUp : k.cLow;
+			SDLKey sym = SDLK_UNKNOWN;
+			UCode lc = k.cLow;
+			if (lc < 128) sym = (SDLKey)lc;
+			pushKey(sym, c);
+			shift = false; // one-shot, like a phone keyboard
+			break;
+		}
+		}
+	}
+
+	static void move(int dir)
+	{
+		if (dir == 2) selCol = (selCol + (int)rows[selRow].size() - 1) % (int)rows[selRow].size();
+		else if (dir == 3) selCol = (selCol + 1) % (int)rows[selRow].size();
+		else
+		{
+			Key &cur = rows[selRow][selCol];
+			int cx = cur.x + cur.w / 2;
+			selRow = (selRow + (dir == 0 ? (int)rows.size() - 1 : 1)) % (int)rows.size();
+			int best = 0, bestD = 1 << 30;
+			for (size_t c = 0; c < rows[selRow].size(); ++c)
+			{
+				Key &k = rows[selRow][c];
+				int d = std::abs(k.x + k.w / 2 - cx);
+				if (d < bestD) { bestD = d; best = (int)c; }
+			}
+			selCol = best;
+		}
+	}
+
+	static int dirOf(SDLKey k)
+	{
+		switch (k)
+		{
+		case SDLK_KP8: case SDLK_INSERT: return 0;
+		case SDLK_KP2: case SDLK_F6: return 1;
+		case SDLK_KP4: case SDLK_PAUSE: return 2;
+		case SDLK_KP6: case SDLK_MENU: return 3;
+		default: return -1;
+		}
+	}
+
+	/// Returns true if the event was eaten by the keyboard.
+	static bool handle(SDL_Event &ev)
+	{
+		if (!visible) return false;
+		switch (ev.type)
+		{
+		case SDL_KEYDOWN:
+		{
+			int d = dirOf(ev.key.keysym.sym);
+			if (d >= 0)
+			{
+				if (heldDir != d) { heldDir = d; heldSince = lastRep = SDL_GetTicks(); move(d); }
+				return true;
+			}
+			if (ev.key.keysym.sym == SDLK_ESCAPE) { close(); return true; }
+			return false;
+		}
+		case SDL_KEYUP:
+		{
+			int d = dirOf(ev.key.keysym.sym);
+			if (d >= 0 && d == heldDir) heldDir = -1;
+			if (ev.key.keysym.sym == SDLK_ESCAPE) return true;
+			return false; // let pad navigation see releases
+		}
+		case SDL_MOUSEBUTTONDOWN:
+			if (ev.button.button == SDL_BUTTON_LEFT) { press(); return true; }
+			if (ev.button.button == SDL_BUTTON_RIGHT) { pushKey(SDLK_BACKSPACE, 8); return true; }
+			return true;
+		case SDL_MOUSEBUTTONUP:
+			return true;
+		default:
+			return false;
+		}
+	}
+
+	static TextEdit *focusedEdit(State *state)
+	{
+		const std::vector<Surface*> &surfaces = state->getSurfaces();
+		for (std::vector<Surface*>::const_iterator i = surfaces.begin(); i != surfaces.end(); ++i)
+		{
+			TextEdit *te = dynamic_cast<TextEdit*>(*i);
+			if (te && te->getVisible() && !te->getHidden() && te->isFocused()) return te;
+		}
+		return 0;
+	}
+
+	static void think(State *state)
+	{
+		TextEdit *te = focusedEdit(state);
+		bool focused = te != 0;
+		if (focused && !wasFocused && !visible)
+		{
+			// keep the keyboard away from the field being edited
+			open(true, te->getY() + te->getHeight() / 2 > Options::baseYResolution / 2);
+		}
+		else if (!focused && wasFocused && visible && autoOpened)
+		{
+			close();
+		}
+		wasFocused = focused;
+		if (visible && heldDir >= 0)
+		{
+			Uint32 now = SDL_GetTicks();
+			if (now - heldSince > 350 && now - lastRep > 110) { lastRep = now; move(heldDir); }
+		}
+	}
+
+	static Uint8 nearest(SDL_Color *pal, int r, int g, int b)
+	{
+		int best = 0, bestD = 1 << 30;
+		for (int i = 1; i < 256; ++i)
+		{
+			int dr = pal[i].r - r, dg = pal[i].g - g, db = pal[i].b - b;
+			int d = dr * dr + dg * dg + db * db;
+			if (d < bestD) { bestD = d; best = i; }
+		}
+		return (Uint8)best;
+	}
+
+	static void blit(Surface *screen)
+	{
+		if (!visible || !game) return;
+		SDL_Color *pal = screen->getPalette();
+		if (!pal) return;
+		Uint8 cBack = nearest(pal, 0, 0, 0);
+		Uint8 cFrame = nearest(pal, 110, 110, 130);
+		Uint8 cText = nearest(pal, 225, 225, 225);
+		Uint8 cSel = nearest(pal, 230, 200, 60);
+		Uint8 cShift = nearest(pal, 120, 220, 120);
+		Font *big = game->getMod()->getFont("FONT_BIG", false), *small = game->getMod()->getFont("FONT_SMALL", false);
+		if (!small) return;
+
+		screen->lock();
+		// dithered background: every other pixel, so the game shows through
+		for (int y = originY; y < originY + totalH; ++y)
+			for (int x = originX + ((y & 1) ? 1 : 0); x < originX + totalW; x += 2)
+				screen->setPixel(x, y, cBack);
+		for (size_t r = 0; r < rows.size(); ++r)
+		{
+			for (size_t c = 0; c < rows[r].size(); ++c)
+			{
+				Key &k = rows[r][c];
+				bool sel = ((int)r == selRow && (int)c == selCol);
+				if (sel)
+				{
+					for (int y = k.y; y < k.y + k.h; ++y)
+						for (int x = k.x; x < k.x + k.w; ++x)
+							screen->setPixel(x, y, cSel);
+				}
+				else
+				{
+					// 75% dark inside keys: leave only one pixel in four see-through
+					for (int y = k.y + 1; y < k.y + k.h - 1; ++y)
+						for (int x = k.x + 1; x < k.x + k.w - 1; ++x)
+							if (!((x & 1) && (y & 1))) screen->setPixel(x, y, cBack);
+					for (int x = k.x; x < k.x + k.w; ++x) { screen->setPixel(x, k.y, cFrame); screen->setPixel(x, k.y + k.h - 1, cFrame); }
+					for (int y = k.y; y < k.y + k.h; ++y) { screen->setPixel(k.x, y, cFrame); screen->setPixel(k.x + k.w - 1, y, cFrame); }
+				}
+			}
+		}
+		screen->unlock();
+
+		// labels: render with the game font, then stamp in a single colour
+		for (size_t r = 0; r < rows.size(); ++r)
+		{
+			for (size_t c = 0; c < rows[r].size(); ++c)
+			{
+				Key &k = rows[r][c];
+				const std::string &label = shift ? k.up : k.low;
+				if (!k.txt)
+				{
+					k.txt = new Text(k.w, 9, k.x, k.y + 3);
+					k.txt->initText(big, small, game->getLanguage());
+					k.txt->setSmall();
+					k.txt->setAlign(ALIGN_CENTER);
+					k.txt->setColor(0); // raw font values: 1-2 = stroke, 3-5 = outline
+				}
+				if (k.shown != label)
+				{
+					k.shown = label;
+					k.txt->setText(label);
+				}
+				k.txt->setPalette(pal);
+				k.txt->draw();
+				bool sel = ((int)r == selRow && (int)c == selCol);
+				Uint8 col = sel ? cBack : ((k.sp == K_SHIFT && shift) ? cShift : cText);
+				k.txt->lock();
+				screen->lock();
+				for (int y = 0; y < k.txt->getHeight(); ++y)
+					for (int x = 0; x < k.txt->getWidth(); ++x)
+					{
+						Uint8 v = k.txt->getPixel(x, y);
+						if (!v) continue;
+						if (v <= 2) screen->setPixel(k.txt->getX() + x, k.txt->getY() + y, col);
+						else if (!sel) screen->setPixel(k.txt->getX() + x, k.txt->getY() + y, cBack);
+					}
+				screen->unlock();
+				k.txt->unlock();
+			}
+		}
+	}
+}
+
+// ---------------------------------------------------------------------------
+// Pad navigation (handhelds): numpad 8/2/4/6 drive the cursor.
+// Over buttons/lists the cursor snaps to the next clickable element in that
+// direction; over big areas (globe, battlescape map, inventory...) or when
+// there is nothing in that direction it moves freely with acceleration.
+// ---------------------------------------------------------------------------
+namespace PadNav
+{
+	struct Cand { int x, y, w, h; int tx, ty; };
+
+	static bool held[4] = { false, false, false, false }; // up, down, left, right
+	static int lastDir = -1;
+	static bool freeMode = false;
+	static Uint32 pressTime = 0, lastRepeat = 0, lastThink = 0;
+	static double accX = 0.0, accY = 0.0;
+	static double freeX = 0.0, freeY = 0.0;
+	// L1/R1 arrive as PageUp/PageDown: tap = normal key, hold + d-pad = free cursor
+	static bool modHeld[2] = { false, false }, modUsed[2] = { false, false };
+	static SDL_Event modDown[2];
+	static int passthrough = 0;
+
+	static bool modActive() { return modHeld[0] || modHeld[1]; }
+	static const int DX[4] = { 0, 0, -1, 1 };
+	static const int DY[4] = { -1, 1, 0, 0 };
+
+	static int keyToDir(SDLKey k)
+	{
+		switch (k)
+		{
+		case SDLK_KP8: case SDLK_INSERT: return 0;
+		case SDLK_KP2: case SDLK_F6: return 1;
+		case SDLK_KP4: case SDLK_PAUSE: return 2;
+		case SDLK_KP6: case SDLK_MENU: return 3;
+		default: return -1;
+		}
+	}
+
+	static void calibrate();
+	static void getMouse(Screen *screen, double &gx, double &gy)
+	{
+		calibrate();
+		int mx, my;
+		SDL_GetMouseState(&mx, &my);
+		gx = (mx - screen->getCursorLeftBlackBand()) / screen->getXScale();
+		gy = (my - screen->getCursorTopBlackBand()) / screen->getYScale();
+	}
+
+	// sdl12-compat on SDL2 letterboxes the window: SDL_WarpMouse takes physical
+	// coordinates while SDL_GetMouseState reports logical ones. We learn the
+	// offset by comparing where we asked to go with where we ended up.
+	static int corrX = 0, corrY = 0;
+	static bool pending = false;
+	static int wantX = 0, wantY = 0;
+	static Uint32 warpTime = 0;
+
+	static void calibrate()
+	{
+		if (!pending || SDL_GetTicks() - warpTime < 40) return;
+		pending = false;
+		int ax, ay;
+		SDL_GetMouseState(&ax, &ay);
+		int dx = wantX - ax, dy = wantY - ay;
+		if ((dx || dy) && std::abs(dx) < 200 && std::abs(dy) < 200)
+		{
+			corrX += dx;
+			corrY += dy;
+			Log(LOG_INFO) << "[padnav] warp offset corrected by " << dx << "," << dy << " -> total " << corrX << "," << corrY;
+		}
+	}
+
+	static void warp(Screen *screen, double gx, double gy)
+	{
+		int maxX = Options::baseXResolution - 1, maxY = Options::baseYResolution - 1;
+		if (gx < 0) gx = 0; if (gy < 0) gy = 0;
+		if (gx > maxX) gx = maxX; if (gy > maxY) gy = maxY;
+		int sx = (int)(gx * screen->getXScale() + screen->getCursorLeftBlackBand() + 0.5);
+		int sy = (int)(gy * screen->getYScale() + screen->getCursorTopBlackBand() + 0.5);
+		SDL_WarpMouse(sx + corrX, sy + corrY);
+		wantX = sx; wantY = sy; pending = true; warpTime = SDL_GetTicks();
+		SDL_Event ev;
+		ev.type = SDL_MOUSEMOTION;
+		ev.motion.type = SDL_MOUSEMOTION;
+		ev.motion.state = SDL_GetMouseState(0, 0);
+		ev.motion.x = sx;
+		ev.motion.y = sy;
+		ev.motion.xrel = 0;
+		ev.motion.yrel = 0;
+		SDL_PushEvent(&ev);
+	}
+
+	static bool usable(Surface *s)
+	{
+		return s && s->getVisible() && !s->getHidden() && s->getWidth() > 0 && s->getHeight() > 0;
+	}
+
+	static bool isLarge(Surface *s)
+	{
+		double area = (double)s->getWidth() * s->getHeight();
+		return area > 0.35 * Options::baseXResolution * Options::baseYResolution;
+	}
+
+	static bool inside(const Cand &c, double px, double py)
+	{
+		return px >= c.x && px < c.x + c.w && py >= c.y && py < c.y + c.h;
+	}
+
+	static const std::list<State*> *allStates = 0;
+
+	/// Large areas (globe, map...) of every visible state, top state included.
+	static void collectLarge(std::vector<Cand> &out)
+	{
+		if (!allStates || allStates->empty()) return;
+		std::list<State*>::const_iterator i = allStates->end();
+		do { --i; } while (i != allStates->begin() && !(*i)->isScreen());
+		for (; i != allStates->end(); ++i)
+		{
+			const std::vector<Surface*> &surfaces = (*i)->getSurfaces();
+			for (std::vector<Surface*>::const_iterator j = surfaces.begin(); j != surfaces.end(); ++j)
+			{
+				InteractiveSurface *is = dynamic_cast<InteractiveSurface*>(*j);
+				if (!is || !usable(is) || dynamic_cast<TextList*>(is) || !isLarge(is)) continue;
+				Cand c = { is->getX(), is->getY(), is->getWidth(), is->getHeight(), 0, 0 };
+				out.push_back(c);
+			}
+		}
+	}
+
+	/// Collects clickable targets of the top state. Returns true if the cursor is over a large area.
+	static bool collect(State *state, double px, double py, std::vector<Cand> &out, TextList *&listUnder)
+	{
+		bool overLarge = false;
+		listUnder = 0;
+		const std::vector<Surface*> &surfaces = state->getSurfaces();
+		InteractiveSurface *modal = state->getModal();
+		for (std::vector<Surface*>::const_iterator i = surfaces.begin(); i != surfaces.end(); ++i)
+		{
+			InteractiveSurface *is = dynamic_cast<InteractiveSurface*>(*i);
+			if (!is || !usable(is)) continue;
+			if (modal && is != modal) continue;
+			TextList *list = dynamic_cast<TextList*>(is);
+			if (list)
+			{
+				for (int a = 0; a < 2; ++a)
+				{
+					const std::vector<ArrowButton*> &arrows = a ? list->getNavArrowsRight() : list->getNavArrowsLeft();
+					for (std::vector<ArrowButton*>::const_iterator j = arrows.begin(); j != arrows.end(); ++j)
+					{
+						Surface *ar = (Surface*)(*j);
+						if (!usable(ar)) continue;
+						Cand c = { ar->getX(), ar->getY(), ar->getWidth(), ar->getHeight(), ar->getX() + ar->getWidth() / 2, ar->getY() + ar->getHeight() / 2 };
+						out.push_back(c);
+					}
+				}
+				int rh = list->getNavRowHeight();
+				if (!list->isSelectable() || rh <= 0) continue;
+				if (px >= list->getX() && px < list->getX() + list->getWidth() && py >= list->getY() && py < list->getY() + list->getHeight())
+					listUnder = list;
+				size_t rows = list->getRows(), scroll = list->getNavScroll();
+				size_t vis = list->getNavVisibleRows();
+				size_t n = rows > scroll ? std::min(vis, rows - scroll) : 0;
+				int tx = (px >= list->getX() + 2 && px < list->getX() + list->getWidth() - 2) ? (int)px : list->getX() + std::min(list->getWidth() / 2, 60);
+				for (size_t k = 0; k < n; ++k)
+				{
+					int y = list->getY() + (int)k * rh;
+					if (y + rh / 2 >= list->getY() + list->getHeight()) break;
+					Cand c = { list->getX(), y, list->getWidth(), rh, tx, y + rh / 2 };
+					out.push_back(c);
+				}
+				continue;
+			}
+			if (isLarge(is))
+			{
+				if (px >= is->getX() && px < is->getX() + is->getWidth() && py >= is->getY() && py < is->getY() + is->getHeight())
+					overLarge = true;
+				continue;
+			}
+			Cand c = { is->getX(), is->getY(), is->getWidth(), is->getHeight(), is->getX() + is->getWidth() / 2, is->getY() + is->getHeight() / 2 };
+			out.push_back(c);
+		}
+		return overLarge;
+	}
+
+	/// Tries to snap in a direction. Returns false if there is nowhere to go.
+	static bool snap(State *state, Screen *screen, int dir)
+	{
+		double px, py;
+		getMouse(screen, px, py);
+		std::vector<Cand> cands;
+		TextList *listUnder = 0;
+		bool overLarge = collect(state, px, py, cands, listUnder);
+		std::vector<Cand> large;
+		collectLarge(large);
+		bool onSmall = false, nextSmall = false, nextLarge = false;
+		double qx = px + DX[dir] * 6, qy = py + DY[dir] * 6;
+		for (size_t i = 0; i < cands.size(); ++i)
+		{
+			const Cand &c = cands[i];
+			if (!inside(c, px, py)) continue;
+			onSmall = true;
+			// probe just outside the element we're on
+			if (dir == 0) qy = c.y - 4;
+			else if (dir == 1) qy = c.y + c.h + 3;
+			else if (dir == 2) qx = c.x - 4;
+			else qx = c.x + c.w + 3;
+			break;
+		}
+		for (size_t i = 0; i < cands.size(); ++i)
+			if (!inside(cands[i], px, py) && inside(cands[i], qx, qy)) nextSmall = true;
+		for (size_t i = 0; i < large.size(); ++i)
+		{
+			if (inside(large[i], px, py)) overLarge = true;
+			if (inside(large[i], qx, qy)) nextLarge = true;
+		}
+		// small targets win over big areas they sit on (e.g. battlescape buttons)
+		if (overLarge && !onSmall) return false;
+		// a big area right next to us in that direction: walk into it freely
+		if (nextLarge && !nextSmall) return false;
+
+		// scroll lists when moving past their first/last visible row
+		if (listUnder && (dir == 0 || dir == 1))
+		{
+			int rh = listUnder->getNavRowHeight();
+			size_t rows = listUnder->getRows(), scroll = listUnder->getNavScroll(), vis = listUnder->getNavVisibleRows();
+			size_t n = rows > scroll ? std::min(vis, rows - scroll) : 0;
+			int k = (int)((py - listUnder->getY()) / rh);
+			if (dir == 1 && n > 0 && k >= (int)n - 1 && scroll + vis < rows)
+			{
+				listUnder->scrollDown(false, false);
+				warp(screen, px, py);
+				return true;
+			}
+			if (dir == 0 && k <= 0 && scroll > 0)
+			{
+				listUnder->scrollUp(false, false);
+				warp(screen, px, py);
+				return true;
+			}
+		}
+
+		int best = -1;
+		double bestScore = 1e18;
+		for (size_t i = 0; i < cands.size(); ++i)
+		{
+			const Cand &c = cands[i];
+			if (inside(c, px, py)) continue;
+			// distance from the cursor to the target rectangle along / across the direction
+			double nx = std::max((double)c.x, std::min(px, (double)(c.x + c.w - 1)));
+			double ny = std::max((double)c.y, std::min(py, (double)(c.y + c.h - 1)));
+			double vx = nx - px, vy = ny - py;
+			double along = vx * DX[dir] + vy * DY[dir];
+			double across = std::fabs(vx * DY[dir] - vy * DX[dir]);
+			if (along < 1.0) continue;
+			if (across > along * 2.5 + 8) continue;
+			double score = along + across * 2.0;
+			if (score < bestScore) { bestScore = score; best = (int)i; }
+		}
+		if (best < 0) return false;
+		static int snapLogged = 0;
+		if (snapLogged++ < 20) Log(LOG_INFO) << "[padnav] snap " << px << "," << py << " -> " << cands[best].tx << "," << cands[best].ty << " (" << cands.size() << " targets)";
+		warp(screen, cands[best].tx, cands[best].ty);
+		return true;
+	}
+
+	/// Handles a numpad key event. Returns true if consumed.
+	static bool handle(State *state, Screen *screen, SDL_Event &ev)
+	{
+		if (ev.type != SDL_KEYDOWN && ev.type != SDL_KEYUP) return false;
+		SDLKey sym = ev.key.keysym.sym;
+		if (sym == SDLK_PAGEUP || sym == SDLK_PAGEDOWN)
+		{
+			if (passthrough > 0) { --passthrough; return false; }
+			int m = (sym == SDLK_PAGEUP) ? 0 : 1;
+			if (ev.type == SDL_KEYDOWN)
+			{
+				if (modHeld[m]) return true; // key repeat
+				modHeld[m] = true;
+				modUsed[m] = false;
+				modDown[m] = ev;
+				if (modHeld[1 - m])
+				{
+					// L1 + R1: on-screen keyboard
+					modUsed[0] = modUsed[1] = true;
+					OSK::toggle();
+					return true;
+				}
+				if (lastDir >= 0 && held[lastDir])
+				{
+					modUsed[m] = true;
+					freeMode = true;
+					getMouse(screen, freeX, freeY);
+					lastThink = SDL_GetTicks();
+				}
+			}
+			else
+			{
+				modHeld[m] = false;
+				if (!modUsed[m])
+				{
+					// plain tap: replay it for the game
+					SDL_Event up = ev;
+					passthrough += 2;
+					SDL_PushEvent(&modDown[m]);
+					SDL_PushEvent(&up);
+				}
+				else if (!modActive() && lastDir >= 0 && held[lastDir])
+				{
+					// back to button-to-button
+					freeMode = false;
+					pressTime = lastRepeat = SDL_GetTicks();
+				}
+			}
+			return true;
+		}
+		int dir = keyToDir(sym);
+		static int logged = 0;
+		if (ev.type == SDL_KEYDOWN && logged < 40)
+		{
+			++logged;
+			Log(LOG_INFO) << "[padnav] key " << (int)ev.key.keysym.sym << " (" << SDL_GetKeyName(ev.key.keysym.sym) << ") dir=" << dir;
+		}
+		if (dir < 0) return false;
+		if (ev.type == SDL_KEYUP)
+		{
+			held[dir] = false;
+			if (dir == lastDir) { lastDir = -1; freeMode = false; }
+			return true;
+		}
+		if (held[dir]) return true; // key repeat, handled in think()
+		held[dir] = true;
+		lastDir = dir;
+		pressTime = lastRepeat = lastThink = SDL_GetTicks();
+		accX = accY = 0.0;
+		if (modActive())
+		{
+			modUsed[0] = modUsed[0] || modHeld[0];
+			modUsed[1] = modUsed[1] || modHeld[1];
+			freeMode = true;
+		}
+		else
+		{
+			freeMode = !snap(state, screen, dir);
+		}
+		if (freeMode) getMouse(screen, freeX, freeY);
+		return true;
+	}
+
+	/// Called every loop: auto-repeat snapping, free cursor movement.
+	static void think(State *state, Screen *screen)
+	{
+		Uint32 now = SDL_GetTicks();
+		if (lastDir < 0 || !held[lastDir]) { lastThink = now; return; }
+		Uint32 heldFor = now - pressTime;
+		if (!freeMode)
+		{
+			if (heldFor > 350 && now - lastRepeat > 130)
+			{
+				lastRepeat = now;
+				if (!snap(state, screen, lastDir))
+				{
+					freeMode = true;
+					lastThink = now;
+					getMouse(screen, freeX, freeY);
+				}
+			}
+			return;
+		}
+		Uint32 dt = now - lastThink;
+		if (dt < 10) return;
+		lastThink = now;
+		if (dt > 50) dt = 50;
+		// game pixels per millisecond, accelerating while held
+		double speed = std::min(0.04 + heldFor * 0.00025, 0.30);
+		double mx = 0, my = 0;
+		for (int d = 0; d < 4; ++d)
+			if (held[d]) { mx += DX[d]; my += DY[d]; }
+		accX += mx * speed * dt;
+		accY += my * speed * dt;
+		int ix = (int)accX, iy = (int)accY;
+		if (ix == 0 && iy == 0) return;
+		accX -= ix; accY -= iy;
+		freeX = std::max(0.0, std::min(freeX + ix, (double)(Options::baseXResolution - 1)));
+		freeY = std::max(0.0, std::min(freeY + iy, (double)(Options::baseYResolution - 1)));
+		warp(screen, freeX, freeY);
+	}
+}
